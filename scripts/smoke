#!/usr/bin/env bash
# Headless smoke test in the dev VM: start boring, open an X11 and a Wayland
# client, take a screenshot, check the compositor survived. See dev/README.md.
set -euo pipefail
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
vm="$repo_dir/scripts/vm"
out="${1:-vm-screenshot.png}"
log="$(mktemp)"

"$vm" kill >/dev/null 2>&1 || true
"$vm" run "${@:2}" >"$log" 2>&1 &
trap '"$vm" kill >/dev/null 2>&1 || true' EXIT

"$vm" exec sh -c 'for i in $(seq 1 60); do [ -S "$XDG_RUNTIME_DIR/wayland-0" ] && sleep 1 && exit 0; sleep 0.5; done; exit 1' \
    || { echo "compositor did not start:"; cat "$log"; exit 1; }
"$vm" exec sh -c 'WAYLAND_DISPLAY=wayland-0 setsid foot >/tmp/foot.log 2>&1 & sleep 2'
"$vm" screenshot "$out" >/dev/null
"$vm" exec sh -c 'pgrep -f "switch.lua compositor" >/dev/null && pgrep -x foot >/dev/null' \
    || { echo "compositor or client died:"; cat "$log"; exit 1; }
if grep -E 'err!|Fatal|Assertion' "$log"; then
    echo "errors in compositor log (above)"; exit 1
fi
echo "smoke OK: $out"
