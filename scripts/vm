#!/usr/bin/env bash
# Manage the boring development VM (Lima, macOS host). See dev/README.md.
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
vm="${BORING_VM:-boring}"

usage() {
    cat <<'USAGE'
Usage: scripts/vm <command> [args...]

Lifecycle:
  up                 Create (first time) and start the VM.
  down               Stop the VM.
  destroy            Delete the VM and its disk.
  status             Show the VM state.

Development (all run inside the VM, in the repository directory):
  run [args...]      Start the compositor. Ctrl-C to stop. Headless unless the
                     VM has a display (see BORING_VM_DISPLAY). Defaults to
                     --config=configs/nested-wayland.lua.
  kill               Stop a compositor started by `run`.
  screenshot [file]  Capture the running compositor's output (default: vm-screenshot.png).
  client <cmd...>    Run a Wayland client against the running compositor.
  test [args...]     luajit tests/run.lua [args...]   (default: --suite all)
  ffi-gen            Regenerate shared/ffi from the VM's headers and check layouts.
  shell              Interactive shell.
  exec <cmd...>      Run a command.

Environment:
  BORING_VM=boring        Lima instance name.
  BORING_VM_DISPLAY=vz    On `up` (creation only): give the VM a display window, and
                          `run` uses DRM + libinput on it instead of headless.
  WLR_RENDERER=pixman     Renderer for `run`.
USAGE
}

need_lima() {
    command -v limactl >/dev/null || {
        echo "limactl not found; install it with: brew install lima" >&2
        exit 2
    }
}

exists() { limactl list --quiet 2>/dev/null | grep -qx "$vm"; }
running() { [[ "$(limactl list --format '{{.Status}}' "$vm" 2>/dev/null)" == "Running" ]]; }

ensure_running() {
    exists || { echo "VM '$vm' does not exist; run: scripts/vm up" >&2; exit 2; }
    running || limactl start "$vm"
}

in_vm() {
    ensure_running
    limactl shell --workdir "$repo_dir" "$vm" -- "$@"
}

cmd="${1:-}"
[[ -n "$cmd" ]] && shift
[[ "$cmd" != "" && "$cmd" != help && "$cmd" != -h && "$cmd" != --help ]] && need_lima

case "$cmd" in
    up)
        fresh=0
        if ! exists; then
            fresh=1
            # Mount the checkout at the same path as on the host, so paths in
            # logs and errors match what you see in your editor.
            limactl create --name="$vm" --tty=false \
                --set ".mounts = [{\"location\": \"$repo_dir\", \"mountPoint\": \"$repo_dir\", \"writable\": true}]" \
                --set ".video.display = \"${BORING_VM_DISPLAY:-none}\"" \
                "$repo_dir/dev/lima.yaml"
        fi
        running || limactl start "$vm"
        # Provisioning adds us to the video/input/seat groups after Lima's
        # persistent SSH session already exists; reconnect to pick them up.
        [[ "$fresh" == 1 ]] && limactl shell --reconnect "$vm" -- true
        ;;
    down) limactl stop "$vm" ;;
    destroy) limactl delete --force "$vm" ;;
    status) limactl list "$vm" ;;
    shell) in_vm bash -l ;;
    exec) in_vm "$@" ;;
    client) in_vm env WAYLAND_DISPLAY=wayland-0 "$@" ;;
    ffi-gen) in_vm sh -c 'luajit tools/ffi_gen.lua && luajit tools/ffi_check.lua' ;;
    test)
        [[ $# -eq 0 ]] && set -- --suite all
        in_vm luajit tests/run.lua "$@"
        ;;
    run)
        has_config=0
        for arg in "$@"; do
            [[ "$arg" == --config || "$arg" == --config=* ]] && has_config=1
        done
        [[ "$has_config" == 0 ]] && set -- --config=configs/nested-wayland.lua "$@"
        # A VM created with a display has a DRM card; otherwise go headless.
        in_vm sh -c '
            if [ -e /dev/dri/card0 ]; then
                export LIBSEAT_BACKEND=seatd WLR_BACKENDS=drm,libinput
            else
                export WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1
            fi
            export WLR_RENDERER="$0"
            exec luajit switch.lua compositor "$@"
        ' "${WLR_RENDERER:-pixman}" "$@"
        ;;
    kill) in_vm pkill -f "switch.lua compositor" || echo "no compositor running" ;;
    screenshot)
        out="${1:-vm-screenshot.png}"
        in_vm env WAYLAND_DISPLAY=wayland-0 grim /tmp/boring-screenshot.png
        limactl copy "$vm:/tmp/boring-screenshot.png" "$out"
        echo "$out"
        ;;
    -h|--help|help|"") usage ;;
    *) echo "unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
