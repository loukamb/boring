---
import "../styles/global.css"
import { Image } from "astro:assets"

import Logo from "../../public/favicon.png"
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <title>boring{Astro.props.title && ` - ${Astro.props.title}`}</title>
  </head>
  <body>
    <header>
      <a href="/">
        <Image src={Logo} alt="" width={64} height={64} />
      </a>
      <nav>
        <a href="/">home</a>
        <a href="/about">about</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  @reference "../styles/global.css";

  header {
    @apply flex items-end py-4;

    nav {
      @apply ml-auto;
    }
  }

  html {
    @apply bg-amber-100 text-amber-950 px-4;
  }

  body {
    @apply container mx-auto;
  }

  main {
    a {
      @apply text-blue-900 font-semibold underline hover:no-underline;
    }
  }
</style>
