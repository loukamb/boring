---
import "../styles/global.css"
import "@fontsource-variable/gelasio"
import "@fontsource-variable/gelasio/wght-italic.css"
import { Image } from "astro:assets"

import Logo from "../../public/mallards.png"
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <title>boring{Astro.props.title && ` - ${Astro.props.title}`}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">boring</a>
        <a href="/">home</a>
        <a href="/faq">faq</a>
        <a href="/license">license</a>
        <a href="https://github.com/loukamb/boring" target="_blank"
          >source code</a
        >
      </nav>
      <Image src={Logo} alt="" height={128} class="mallards" />
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  @reference "../styles/global.css";

  header {
    @apply flex items-end py-4;

    nav {
      @apply space-x-2;

      a {
        @apply hover:bg-sky-200 first:text-2xl first:italic first:font-bold;
      }
    }

    .mallards {
      @apply block ml-auto translate-x-5;
    }
  }

  html {
    @apply bg-sky-100 text-sky-950 px-4 font-serif;
  }

  body {
    @apply container mx-auto pb-16;
  }

  main {
    a {
      @apply text-blue-900 font-semibold underline hover:no-underline;
    }
  }
</style>
