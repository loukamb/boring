{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "website",
	"compatibility_date": "2026-06-29",

	// Pure static site: the Astro build (output: 'static') is served directly
	// from ./dist as assets — no Worker script, no adapter, no KV/Images bindings.
	"assets": {
		"directory": "./dist"
	},

	// boringwm.org is the sole custom route; the zone already exists in Cloudflare.
	"routes": [
		{ "pattern": "boringwm.org", "custom_domain": true }
	],

	// Disable the auto-assigned *.workers.dev (a.k.a. pages.dev) URL and
	// per-deployment preview URLs, so boringwm.org is the only entry point.
	"workers_dev": false,
	"preview_urls": false
}
