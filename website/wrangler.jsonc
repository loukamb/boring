{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-06-29",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "website",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},

	// boringwm.org is the sole custom route; the zone already exists in the
	// Cloudflare account, so custom_domain binds the apex straight to this Worker.
	"routes": [
		{ "pattern": "boringwm.org", "custom_domain": true }
	],

	// Disable the auto-assigned *.workers.dev (a.k.a. pages.dev) URL and the
	// per-deployment preview URLs, so boringwm.org is the only way to reach the site.
	"workers_dev": false,
	"preview_urls": false
}
